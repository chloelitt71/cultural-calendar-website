# NewsAPI key (used by both Moments and Who Is This?). Vite dev proxies /news-api → newsapi.org/v2.
# VITE_NEWS_API_KEY=
# NEWS_API_KEY=

# Calendar: richer live events (Ticketmaster Discovery) + film/TV premieres (TMDb)
# VITE_TICKETMASTER_API_KEY=
# VITE_TMDB_API_KEY=

# Supabase (required for auth/data features)
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# Optional local dev proxy key for /openai-api in vite.config.ts
# VITE_OPENAI_API_KEY=
