{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/news-api/:path*",
      "destination": "https://newsapi.org/v2/:path*"
    },
    {
      "source": "/kg-api/:path*",
      "destination": "https://kgsearch.googleapis.com/v1/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
